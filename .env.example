# Environment variables for Docker Compose
# Copy this file to .env and update the values

# Certificate password for HTTPS development
# Replace 'your_certificate_password' with your actual certificate password
CERT_PASSWORD=your_certificate_password

# Alternative: Set to empty string if no password
# CERT_PASSWORD=

# Example for common development certificate passwords:
# CERT_PASSWORD=password
# CERT_PASSWORD=
# CERT_PASSWORD=mycertpassword